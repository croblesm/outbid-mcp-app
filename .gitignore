.env
.env.*
!.env.example
*.pem
*.key
*.p12

# local Supabase
supabase/.temp
# Written by `supabase start` and `supabase link`: pinned service versions and the linked project.
supabase/supabase.lock
supabase/.branches
dist-view
supabase/functions/.env
# Written by `claude mcp add --scope project` (Studio, Connect, MCP): points at this machine's local port.
.mcp.json
