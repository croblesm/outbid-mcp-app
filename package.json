{
  "name": "outbid",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:rls": "vitest run tests",
    "env:local": "supabase status --env --output-format json | node -e 'let s=\"\";process.stdin.on(\"data\",c=>s+=c).on(\"end\",()=>{const e=JSON.parse(s.slice(s.indexOf(\"{\")));const v=e.env??e;console.log(`VITE_SUPABASE_URL=${v.API_URL}\\nVITE_SUPABASE_PUBLISHABLE_KEY=${v.PUBLISHABLE_KEY}`)})' > .env.local",
    "types": "supabase gen types --lang typescript --local > src/database.types.ts",
    "gauntlet": "tools/gauntlet.sh",
    "build:view": "node tools/build-view.mjs",
    "env:hosted": "node tools/env-hosted.mjs",
    "dev:hosted": "vite --mode hosted"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.21.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  }
}
